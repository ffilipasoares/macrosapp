# Local development runs against the Firebase emulators; no real project is needed.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-mealplan
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_STORAGE_BUCKET=demo-mealplan.appspot.com
# Always use the local backend (through the dev server's /api proxy), even when
# .env.local points VITE_API_URL at Cloud Run for production builds.
VITE_API_URL=
