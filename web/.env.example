# Copy to .env.local and fill in from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Project settings -> Cloud Messaging -> Web Push certificates -> Key pair.
VITE_FIREBASE_VAPID_KEY=
# The backend's Cloud Run address (printed by `gcloud run deploy`), e.g.
# https://mealplan-api-abc123-ew.a.run.app . The app then calls it directly, so
# planning is not cut off by Firebase Hosting after 60 seconds. Leave empty to go
# through Hosting.
VITE_API_URL=
